#!/usr/bin/env php
<?php

define('PROJECT_ROOT', __DIR__ . '/../../../../');

require PROJECT_ROOT . 'vendor/autoload.php';

use Laminas\Mvc\Application as LaminasApp;
use Monarc\BackOffice\Command\NotifyExpiredInvitationsCommand;
use Symfony\Component\Console\Application as ConsoleApp;

$appConfig = require PROJECT_ROOT . 'config/application.config.php';
$laminasApp = LaminasApp::init($appConfig);

$consoleApp = new ConsoleApp();

$consoleApp->add($laminasApp->getServiceManager()->get(NotifyExpiredInvitationsCommand::class));

$consoleApp->run();
